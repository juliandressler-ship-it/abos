    "Abos, die nicht im Backup sind, bleiben unverändert. Mit ⌘Z lässt sich der Import rückgängig machen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos, die nicht im Backup sind, bleiben unverändert. Mit ⌘Z lässt sich der Import rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions that are not in the backup stay unchanged. You can undo the import with ⌘Z."
          }
        }
      }
    },
