    "Deine Abos liegen nur auf diesem Mac und werden von Time Machine mitgesichert. Ein Backup ist eine einzelne Datei, die du z. B. in iCloud Drive ablegen und hier wieder importieren kannst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Abos liegen nur auf diesem Mac und werden von Time Machine mitgesichert. Ein Backup ist eine einzelne Datei, die du z. B. in iCloud Drive ablegen und hier wieder importieren kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscriptions are stored only on this Mac and are included in Time Machine backups. A backup is a single file you can keep, for example, in iCloud Drive and import here again."
          }
        }
      }
    },
    "Der Tag, an dem das Abo weiterläuft – meist der Tag der nächsten Zahlung": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tag, an dem das Abo weiterläuft – meist der Tag der nächsten Zahlung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day the subscription continues – usually the day of the next payment"
          }
        }
      }
    },
    "Der Termin wiederholt sich %@ und rückt danach automatisch weiter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Termin wiederholt sich %@ und rückt danach automatisch weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date repeats %@ and moves forward automatically."
          }
        }
      }
    },
    "Der Wechsel steht danach mit Datum im Verlauf, der Kostenverlauf rechnet ab dann mit dem neuen Preis.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wechsel steht danach mit Datum im Verlauf, der Kostenverlauf rechnet ab dann mit dem neuen Preis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change is recorded with its date in the history; the cost chart uses the new price from then on."
          }
        }
      }
    },
    "Der aktuelle Betrag des Abos bleibt unverändert": {
