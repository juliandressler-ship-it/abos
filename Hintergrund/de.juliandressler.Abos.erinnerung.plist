<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hintergrund-Prüfung: startet Abos ohne Fenster, stellt fällige Erinnerungen zu und beendet sich wieder -->
	<key>Label</key>
	<string>de.juliandressler.Abos.erinnerung</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Abos</string>
	<key>ProgramArguments</key>
	<array>
		<string>Abos</string>
		<string>--erinnern</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>de.juliandressler.Abos</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
